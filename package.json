{
  "name": "dsh-backup-sync",
  "version": "0.1.0",
  "description": "备份同步 —— 可视化备份/恢复 DSH 资产（技能、插件、配置、记忆、待办、对话），并支持带基线的增量导入",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "backup",
    "restore",
    "sync"
  ],
  "license": "MIT",
  "author": "Arlenman <11390060+Arlenman@users.noreply.github.com>",
  "homepage": "https://github.com/Arlenman/dsh-backup-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arlenman/dsh-backup-sync.git"
  },
  "bugs": {
    "url": "https://github.com/Arlenman/dsh-backup-sync/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "scan": "node scripts/scan-report.mjs",
    "guard": "node scripts/guard-report.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
